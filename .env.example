NODE_ENV=development
PORT=5000
MONGODB_URI=database URI example: mongodb://myuser:mypassword@127.0.0.1:27017/devTribeDB?authSource=admin
CLIENT_ORIGIN=frontend URL example http://localhost:5173
JWT_ACCESS_SECRET=LONG_RANDOM_STRING
JWT_REFRESH_SECRET=LONG_RANDOM_STRING

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CREATE YOUR .env file with these variables

